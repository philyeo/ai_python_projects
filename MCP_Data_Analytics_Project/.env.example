# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values. Never commit .env.
# ---------------------------------------------------------------------------

# LLM (OpenRouter-compatible OpenAI API)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-4o-mini

# Web Search MCP (Tavily)
# Remote MCP endpoint. Leave blank to use the default Tavily URL.
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
# Optional. Tavily also offers keyless access for Search and Extract.
TAVILY_API_KEY=

# MCP Aggregator
AGGREGATOR_HOST=127.0.0.1
AGGREGATOR_PORT=8000
# AGGREGATOR_URL=http://127.0.0.1:8000/mcp

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=True
SECRET_KEY=

# RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./vector_store

# Data
UPLOAD_FOLDER=./uploads
DATA_FOLDER=./data
